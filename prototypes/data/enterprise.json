    "views": [
      {
        "id": "chain",
        "label": "Processes to infrastructure",
        "kind": "tree",
        "root_type": "business_process",
        "levels": [
          {
            "via": "supported_by",
            "from_role": "process",
            "to_role": "application"
          },
          {
            "via": "runs_on",
            "from_role": "application",
            "to_role": "server"
          },
          {
            "via": "located_in",
            "from_role": "server",
            "to_role": "datacenter"
          }
        ]
      },
      {
        "id": "applications",
        "label": "All applications",
        "kind": "list",
        "type": "application"
      }
