          "name",
          "owner"
        ]
      },
      "application": {
        "label": "Application",
        "icon": "🧩",
        "title_attribute": "name",
        "attribute_order": [
          "name",
          "lifecycle"
        ]
      },
      "server": {
        "label": "Server",
        "icon": "🖥",
